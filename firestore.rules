rules_version = '2';

// Family chat: only Google accounts listed in config/members (field `emails`,
// lowercase) can read or post. That document is managed outside the app
// (scripts/add-member.sh or the Firebase console) so the list of family emails
// never lives in this public repo, and clients can't read or change it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
           in get(/databases/$(database)/documents/config/members).data.emails;
    }

    // channel "family" (the default) is the family chat, where text starting
    // with "/" is a request to the assistant; channel "assistant" is the
    // assistant tab, where everything is a request. Assistant replies, status
    // and every assistant-owned collection below are written only by the
    // Cloud Function (Admin SDK), never by clients.
    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'photo', 'createdAt', 'channel'])
        && request.resource.data.get('channel', 'family') in ['family', 'assistant']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    // Each member's private thread with the assistant, their private memory
    // and its change log: only that member can see them. They post requests
    // (channel "private"); replies, status, memory and log come from the
    // Cloud Function.
    function isOwner(uid) {
      return isMember() && request.auth.uid == uid;
    }
    match /users/{uid}/thread/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'photo', 'createdAt', 'channel'])
        && request.resource.data.channel == 'private'
        && request.resource.data.uid == uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/memory/{id} {
      allow read: if isOwner(uid);
    }
    match /users/{uid}/auditLog/{id} {
      allow read: if isOwner(uid);
    }
    // Per-member settings written by the functions, e.g. settings/gcal: the
    // Google Calendar link's status. The Google tokens themselves live in
    // gcalAccounts, which no client can read.
    match /users/{uid}/settings/{id} {
      allow read: if isOwner(uid);
    }

    // Push tokens, one doc per device (doc id = FCM token). Only the Cloud
    // Function reads them. A member can claim a token (devices can switch
    // accounts) and delete their own.
    match /tokens/{token} {
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Family calendar, saved places, assistant memory, and the log of every change the assistant made.
    // Everyone in the family can see them; only the assistant changes them,
    // so every change goes through a tracked request and lands in auditLog.
    match /events/{id} {
      allow read: if isMember();
    }
    match /places/{id} {
      allow read: if isMember();
    }
    match /memory/{id} {
      allow read: if isMember();
    }
    match /auditLog/{id} {
      allow read: if isMember();
    }
  }
}
